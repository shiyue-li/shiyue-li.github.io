% Style for cv.tex, matching the website: its beige paper, Shippori Mincho for
% all text, Yuji Mai for Chinese characters, a short moss stroke above each
% section title, and every date flush right in one column. Only the name and
% section titles are bold; everything secondary (subtitle lines, dates, paper
% numbers, the footer) is black in a lighter weight, and subtitles are indented.
\ProvidesPackage{cv}[2026/10/24 Shiyue Li CV style]

% ---------- Page ----------
\RequirePackage[letterpaper, top=0.8in, bottom=0.9in, hmargin=1.05in, footskip=0.4in]{geometry}
\RequirePackage{xcolor}
\RequirePackage{fontspec}
\RequirePackage{amsmath, amssymb}

\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage[hidelinks, pdfusetitle]{hyperref}

\setlength{\parindent}{0pt}
% The indented groups are lists: never break between a group's heading and its
% first line, and don't invite a break after a group either.
\@beginparpenalty=\@M \@endparpenalty=0 \@itempenalty=0

% \cvneedspace{length}: start a new page only if less than length is left.
% (The needspace package also adds a bonus for breaking there, which pulls
% every section onto a fresh page and leaves half-empty pages behind.)
\newcommand{\cvneedspace}[1]{\par\begingroup
  \setlength{\dimen@}{#1}\dimen@ii\pagegoal \advance\dimen@ii-\pagetotal
  \ifdim\dimen@>\dimen@ii \ifdim\dimen@ii>\z@ \vfil\fi \break\fi
  \endgroup}
% Generous stretch, so TeX can rate page breaks and fill each page. With
% \raggedbottom it is never used on the page, only when choosing the breaks.
\setlength{\parskip}{0pt plus 2pt}
\raggedbottom
\frenchspacing
\linespread{1.18}
% Lines within one entry sit closer than the entries do, so each reads as a group.
\newcommand{\cventryspread}{\linespread{1.08}\selectfont}

% ---------- Colors ----------
% The website's beige page, neutral black ink, and its moss green for
% section titles and the email and website links.
\definecolor{paper}{HTML}{F0EBE2}
\definecolor{ink}{HTML}{1F221E}
\definecolor{moss}{HTML}{4F6A44}
\pagecolor{paper}
\AtBeginDocument{\color{ink}}

% ---------- Fonts ----------
% The .ttf files are not in the repository (about 34 MB); see the note in cv.tex.
\providecommand{\cvfontdir}{fonts/}
\setmainfont{ShipporiMincho}[Path=\cvfontdir, Extension=.ttf,
  UprightFont=*-SemiBold, BoldFont=*-ExtraBold]
\newfontfamily\cvheavy{ShipporiMincho}[Path=\cvfontdir, Extension=.ttf,
  UprightFont=*-ExtraBold]
% Subtitle lines (degrees, roles, coauthors, events) are black but lighter.
\newfontfamily\cvlight{ShipporiMincho}[Path=\cvfontdir, Extension=.ttf,
  UprightFont=*-Regular]
\newfontfamily\cvhanfont{YujiMai}[Path=\cvfontdir, Extension=.ttf,
  UprightFont=*-Regular, BoldFont=*-Regular]
\newcommand{\han}[1]{{\cvhanfont #1}}
% Journal and arXiv lines: EB Garamond italic at its regular (light) weight,
% which comes with TeX Live.
\newfontfamily\cvjournalfont{EBGaramond}[Extension=.otf, UprightFont=*-Italic,
  Scale=MatchLowercase]
% For the few Latin letters Shippori Mincho lacks (e.g. ğ); Libertinus comes with TeX Live.
\newfontfamily\cvfallbackfont{LibertinusSerif}[Extension=.otf, UprightFont=*-Semibold, BoldFont=*-Bold]
\newcommand{\fallback}[1]{{\cvfallbackfont #1}}

% Shippori Mincho has no italic, so emphasis is upright, as on the website.
\renewcommand{\emph}[1]{#1}

% ---------- Header and footer ----------
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[L]{\footnotesize\cvlight Shiyue Li\quad Curriculum Vitae}
\fancyfoot[R]{\footnotesize\cvlight\thepage\ / \pageref*{LastPage}}

% \cvheader{name}{chinese name}{position and affiliation}{contact lines}
\newcommand{\cvheader}[4]{%
  \begin{minipage}[b]{0.66\linewidth}
    {\cvheavy\fontsize{22}{27}\selectfont #1}\hspace{0.4em}{\cvhanfont\fontsize{20}{27}\selectfont #2}\par
    \vspace{6pt}
    {\cvlight #3}
  \end{minipage}\hfill
  \begin{minipage}[b]{0.32\linewidth}
    \raggedleft\cvlight #4
  \end{minipage}\par}

% ---------- Sections ----------
% Set by a section title, cleared by the first entry: a group heading right
% under a title must not offer a page break between the two.
\newif\ifcvaftertitle
\newcommand{\cvsection}[1]{%
  \global\cvaftertitletrue
  \par\cvneedspace{6\baselineskip}\addvspace{26pt plus 22pt}%
  \phantomsection\pdfbookmark[1]{#1}{\detokenize{#1}}%
  {\color{moss}\rule{1.6em}{1.1pt}}\par\nobreak\vspace{7pt}%
  {\color{moss}\cvheavy\fontsize{12.5}{15}\selectfont #1}\par\nobreak\vspace{10pt}}

% Every line after the first in an entry (role, advisor, coauthors, journal,
% event) is indented by the same amount, as are the entries of a group.
\newlength{\cvindent}\setlength{\cvindent}{1.2em}

% A group of entries under one heading (an institution, a program), indented.
\newcommand{\cvgroupheading}[2]{%
  \par\ifcvaftertitle\else\cvneedspace{3\baselineskip}\addvspace{12pt plus 8pt}\fi
  \global\cvaftertitlefalse
  #1\if\relax\detokenize{#2}\relax\else, {\cvlight #2}\fi\par\nobreak\vspace{5pt}}
\newenvironment{cvgroup}[2]
  {\cvgroupheading{#1}{#2}\list{}{\leftmargin=\cvindent \rightmargin=0pt \itemsep=0pt \topsep=0pt \parsep=0pt}\item\relax}
  {\endlist\addvspace{8pt}}

% ---------- Entries ----------
% Every date sits flush right in a column of the same width, so they line up.
\newlength{\cvdatewidth}\setlength{\cvdatewidth}{6.6em}
\newlength{\cvdategap}\setlength{\cvdategap}{1.2em}
\newlength{\cventryskip}\setlength{\cventryskip}{12pt plus 8pt}
\newlength{\cvlineskip}\setlength{\cvlineskip}{5pt plus 4pt}

% The lighter, indented lines under an entry's first line.
\newcommand{\cvdetails}[1]{%
  \if\relax\detokenize{#1}\relax\else
    \par\vspace{1pt}{\leftskip=\cvindent\cvlight #1\par}\fi}

% \cventry{date}{first line}{further lines, lighter and indented (may be empty)}
\newcommand{\cventry}[3]{%
  \global\cvaftertitlefalse
  \par\noindent
  \begin{minipage}[t]{\dimexpr\linewidth-\cvdatewidth-\cvdategap\relax}
    \cventryspread\raggedright\hangindent=\cvindent #2%
    \cvdetails{#3}%
  \end{minipage}\hfill
  \makebox[\cvdatewidth][r]{\cvlight #1}\par
  \vspace{\cventryskip}}

% \cvline{date}{text}: a one-line entry in a dense list
\newcommand{\cvline}[2]{%
  \global\cvaftertitlefalse
  \par\noindent
  \begin{minipage}[t]{\dimexpr\linewidth-\cvdatewidth-\cvdategap\relax}
    \cventryspread\raggedright\hangindent=\cvindent #2%
  \end{minipage}\hfill
  \makebox[\cvdatewidth][r]{\cvlight #1}\par
  \vspace{\cvlineskip}}

% cvkeep: keeps a run of lines (one summer's classes, say) on one page.
\newenvironment{cvkeep}{\par\noindent\begin{minipage}{\linewidth}}{\end{minipage}\par}

% \cvitem{date}{first line}{second line, lighter}: a compact two-line entry in a long list
\newlength{\cvitemskip}\setlength{\cvitemskip}{9.5pt plus 6pt}
\newcommand{\cvitem}[3]{{\setlength{\cventryskip}{\cvitemskip}\cventry{#1}{#2}{#3}}}

% \talk{date}{venue}{event}{url}: venue in ink, event on the next line, as on the website
\newcommand{\talk}[4]{%
  \cvitem{#1}{#2}{\if\relax\detokenize{#4}\relax #3\else\href{#4}{#3}\fi}}

% \paper{number}{title}{url}{coauthors}{journal or arXiv id}{journal url}
% Papers run in the website's order, so they have no date column.
\newcommand{\paper}[6]{%
  \global\cvaftertitlefalse
  \par\noindent\llap{\makebox[2.2em][l]{\cvlight\footnotesize #1}}%
  \begin{minipage}[t]{\linewidth}
    \cventryspread\raggedright\hangindent=\cvindent \leavevmode\href{#3}{#2}%
    \cvdetails{\if\relax\detokenize{#4}\relax\else with #4\\\fi
      {\cvjournalfont\if\relax\detokenize{#6}\relax #5\else\href{#6}{#5}\fi}}%
  \end{minipage}\par
  \vspace{\cventryskip}}
